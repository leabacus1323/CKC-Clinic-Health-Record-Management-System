APP_NAME="CKC Clinic Health Record Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ckc_clinic
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Performance cache durations (seconds)
PERFORMANCE_NAVIGATION_CACHE_TTL=30
PERFORMANCE_ANNOUNCEMENT_CACHE_TTL=300
PERFORMANCE_DASHBOARD_CACHE_TTL=60

# Data Privacy Agreement
PRIVACY_TERMS_VERSION=1.0
PRIVACY_TERMS_EFFECTIVE_DATE="June 27, 2026"
PRIVACY_ORGANIZATION="Christ the King College Clinic"
PRIVACY_CONTACT_EMAIL=

# Health privacy, consent, and emergency access
BREAK_GLASS_MINUTES=10
PRIVACY_OFFICER_EMAIL=
CONSENT_MAX_MONTHS=24
HEALTH_AUTHORIZATION_VERSION=1.0
STUDENT_PRIVACY_REGIME=ferpa_student
NON_STUDENT_PRIVACY_REGIME=hipaa_workforce

# Use age_18 for K-12-style guardian control, or postsecondary when rights transfer at enrollment.
STUDENT_RIGHTS_TRANSFER_MODE=age_18


# Aggressive protected-session lock (2-3 minutes recommended)
MEDICAL_IDLE_TIMEOUT_SECONDS=180
MEDICAL_IDLE_WARNING_SECONDS=30

# Permanent medical audit sink. Production must use either:
# 1) an external HTTP collector backed by WORM/retention-lock storage, or
# 2) a physically separate database with an INSERT-only application account.
MEDICAL_AUDIT_DRIVER=database
MEDICAL_AUDIT_FAIL_CLOSED=true
MEDICAL_AUDIT_SIGNING_KEY=
MEDICAL_AUDIT_REQUIRE_EXTERNAL_BOUNDARY=true
MEDICAL_AUDIT_SEPARATION_CONFIRMED=false
MEDICAL_AUDIT_DB_CONNECTION=audit
MEDICAL_AUDIT_TABLE=medical_access_events

AUDIT_DB_DRIVER=mysql
AUDIT_DB_HOST=127.0.0.1
AUDIT_DB_PORT=3306
AUDIT_DB_DATABASE=ckc_clinic_audit
AUDIT_DB_USERNAME=ckc_audit_writer
AUDIT_DB_PASSWORD=
AUDIT_MYSQL_ATTR_SSL_CA=

# Alternative external append-only collector
MEDICAL_AUDIT_HTTP_ENDPOINT=
MEDICAL_AUDIT_HTTP_TOKEN=
MEDICAL_AUDIT_HTTP_TIMEOUT_SECONDS=5

# Set true on every HTTPS production deployment.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=strict

CLINIC_LOW_STOCK_THRESHOLD=10
